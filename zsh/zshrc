# ~/.zshrc — ~/git/dotfiles 가 관리한다 (여기 말고 거기서 고칠 것).
#
# 읽는 순서:  이 파일(모든 OS) → zsh/os/<darwin|linux|wsl>.zsh → ~/.zshrc.local
# 머신별·비밀 설정(API 키, 비밀번호, 한 호스트용 alias)은
# ~/.zshrc.local 에 둔다. 이 파일은 커밋하지 않는다.

# Powerlevel10k instant prompt — 맨 위 근처에 둔다. 이보다 위에서 무언가를 출력하면 안 된다.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

DOTFILES="${DOTFILES:-$HOME/git/dotfiles}"

# 불러올 OS 레이어: darwin, wsl(리눅스의 한 종류), linux.
case "$(uname -s)" in
  Darwin) DOTFILES_OS=darwin ;;
  Linux)  grep -qi microsoft /proc/version 2>/dev/null && DOTFILES_OS=wsl || DOTFILES_OS=linux ;;
  *)      DOTFILES_OS=other ;;
esac
# install.sh 가 고른 프로필 (vanilla | personal). 파일이 없으면 비워 둔다 — setup 스크립트가
# 이 값을 프로필 선택으로 넘기므로 여기서 추측하면 안 된다.
DOTFILES_PROFILE=
[[ -r "$HOME/.config/dotfiles/profile" ]] && DOTFILES_PROFILE=$(<"$HOME/.config/dotfiles/profile")
export DOTFILES DOTFILES_OS DOTFILES_PROFILE

# ---- Oh My Zsh ----
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="powerlevel10k/powerlevel10k"
plugins=(git zsh-autosuggestions zsh-syntax-highlighting)
[[ -r $ZSH/oh-my-zsh.sh ]] && source $ZSH/oh-my-zsh.sh

# ---- 히스토리 ----
HISTSIZE=10000
SAVEHIST=10000
HISTFILE=~/.zsh_history
setopt HIST_IGNORE_ALL_DUPS HIST_FIND_NO_DUPS SHARE_HISTORY

# ---- 환경 ----
export EDITOR=vim
export LANG=en_US.UTF-8
typeset -U path                                   # PATH 중복 제거
path=("$HOME/.local/bin" $path)

# ---- alias ----
alias cla='claude --dangerously-skip-permissions'
alias python='python3'
alias uvrun='uv run python'
alias venv='source .venv/bin/activate'

if command -v lsd >/dev/null; then
  alias ls='lsd' ll='lsd -lah' la='lsd -A' lt='lsd --tree'
else
  alias ll='ls -alF' la='ls -A' l='ls -CF'
fi

# ---- 선택 도구 (설치돼 있을 때만) ----
if [[ -d "$HOME/.bun" ]]; then
  export BUN_INSTALL="$HOME/.bun"
  path=("$BUN_INSTALL/bin" $path)
  [[ -s "$BUN_INSTALL/_bun" ]] && source "$BUN_INSTALL/_bun"
fi
if [[ -s "$HOME/.nvm/nvm.sh" ]]; then
  export NVM_DIR="$HOME/.nvm"
  source "$NVM_DIR/nvm.sh"
  [[ -s "$NVM_DIR/bash_completion" ]] && source "$NVM_DIR/bash_completion"
fi
[[ -f "$HOME/.local/bin/env" ]] && source "$HOME/.local/bin/env"   # uv

# ---- 프롬프트 ----
[[ -f ~/.p10k.zsh ]] && source ~/.p10k.zsh

# ---- OS 레이어, 그다음 이 머신 ----
[[ -r "$DOTFILES/zsh/os/$DOTFILES_OS.zsh" ]] && source "$DOTFILES/zsh/os/$DOTFILES_OS.zsh"
[[ -r ~/.zshrc.local ]] && source ~/.zshrc.local
