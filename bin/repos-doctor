#!/usr/bin/env bash
# repos-doctor — 조용히 고장 난 git·hook·환경 설정을 찾는다. 아무것도 고치지 않는다.
#
#   repos-doctor              # ~/git (또는 $PULL_ALL_ROOT) 아래 레포 점검, 문제만 출력
#   repos-doctor -v           # 정상인 레포도 출력
#   repos-doctor ~/src        # 다른 디렉터리
#
# 2026-09-15~16 에 손으로 찾아낸 고장들을 자동으로 잡는다:
#   - 레포 core.hooksPath 가 옛 경로를 가리켜 신원 검사가 안 돎 (레포를 옮긴 뒤)
#   - 레포 전용 hooks 폴더(.githooks)에 전역 훅 위임이 빠짐 (pre-push·post-merge)
#   - .venv 실행 파일 shebang 이 옮기기 전 경로 → mypy/pytest 실행 불가
#   - graphify-out/ 이 무시되지 않음, 그래프 없음
#   - 전역 링크(~/.gitconfig, ~/.config/git/hooks·ignore) 끊김, ci-gate 인데 gh 미인증, 상대 PC ssh 불가
# 2026-11-27 에 찾은 것도:
#   - crontab 이 지워진 폴더·스크립트를 가리킴 (작업 폴더를 지우거나 레포 이름을 바꾼 뒤 조용히 안 돎)
#   - crontab 에 cron-install 관리 블록 밖의 손으로 적은 줄 (레포가 모르는 작업)
#   - 폴더 이름이 origin 레포 이름과 다름 (GitHub 에서 이름을 바꾼 뒤)
# 종료 코드: 문제가 하나라도 있으면 1.
set -uo pipefail

verbose=0
roots=()
while [ $# -gt 0 ]; do
  case "$1" in
    -v|--verbose) verbose=1; shift ;;
    -h|--help) sed -n '2,15p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) roots+=("$1"); shift ;;
  esac
done
[ ${#roots[@]} -eq 0 ] && roots=("${PULL_ALL_ROOT:-$HOME/git}")

if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
  B=$'\e[1m' D=$'\e[2m' R=$'\e[0m' GRN=$'\e[32m' CYN=$'\e[36m' YLW=$'\e[33m' RED=$'\e[31m'
else
  B='' D='' R='' GRN='' CYN='' YLW='' RED=''
fi

dotfiles="$HOME/git/dotfiles"
problems=0
say_bad()  { printf "  ${RED}✗${R} %s\n" "$1"; problems=$((problems + 1)); }
say_warn() { printf "  ${YLW}●${R} %s\n" "$1"; problems=$((problems + 1)); }
say_ok()   { [ $verbose = 1 ] && printf "  ${GRN}✓${R} %s\n" "$1"; return 0; }

host=$(hostname -s 2>/dev/null || hostname)
echo "${B}${CYN}▸ ${host}${R}  ${D}$(date '+%F %T') · repos-doctor${R}"

# ── 전역 설정 ──────────────────────────────────────────────────────────────
check_link() {  # check_link <대상> <기대하는 원본>
  if [ "$(readlink "$1" 2>/dev/null)" = "$2" ]; then say_ok "${1/#$HOME/~} → dotfiles"
  else say_bad "${1/#$HOME/~} 가 dotfiles 를 가리키지 않음 (install.sh 다시 실행)"; fi
}
check_link "$HOME/.gitconfig"          "$dotfiles/git/gitconfig"
check_link "$HOME/.config/git/hooks"   "$dotfiles/git/hooks"
check_link "$HOME/.config/git/ignore"  "$dotfiles/git/ignore"
profile=$(cat "$HOME/.config/dotfiles/profile" 2>/dev/null || echo "")
personal=${DOTFILES_PERSONAL:-$dotfiles/personal}
case "$profile" in
  personal)
    # personal/ 은 별도 비공개 레포다 — 없거나 원격보다 뒤처지면 링크가 옛 값을 가리킨다
    if [ ! -e "$personal/.git" ]; then
      say_bad "personal 레포가 없다 (${personal/#$HOME/~}) — install.sh --profile personal 이 clone 한다"
    else
      behind=$(git -C "$personal" rev-list --count 'HEAD..@{upstream}' 2>/dev/null || echo "")
      dirty=$(git -C "$personal" status --porcelain 2>/dev/null | head -1)
      if [ -n "$behind" ] && [ "$behind" -gt 0 ]; then say_warn "personal 레포가 원격보다 ${behind}커밋 뒤 — pull-all"
      elif [ -n "$dirty" ]; then say_warn "personal 레포에 커밋 안 한 변경이 있다"
      else say_ok "personal 레포 최신"; fi
    fi
    # ssh: 공통 호스트는 personal 의 ssh/config 한 곳에서만 — 로컬 ~/.ssh/config 에 같은 Host 가 다시 생기면
    # PC 마다 값이 어긋난다(손으로 복사한 블록이 PC 마다 달랐던 적이 있다)
    if [ -f "$personal/ssh/config" ]; then
      check_link "$HOME/.ssh/config.d/dotfiles-personal.conf" "$personal/ssh/config"
      shared_hosts=$(awk '$1=="Host"{for(i=2;i<=NF;i++) print $i}' "$personal/ssh/config" | sort -u)
      dup=$(awk '$1=="Host"{for(i=2;i<=NF;i++) print $i}' "$HOME/.ssh/config" 2>/dev/null | sort -u | comm -12 - <(echo "$shared_hosts") | tr '\n' ' ')
      if [ -n "$dup" ]; then say_warn "$HOME/.ssh/config 에 공통 호스트가 또 있다: ${dup% } — personal 의 ssh/config 에서만 관리할 것"
      else say_ok "ssh 공통 호스트는 personal/ssh/config 에서만"; fi
    fi
    check_link "$HOME/.config/git/profile.gitconfig" "$personal/git/gitconfig"
    check_link "$HOME/.config/git/allowed-emails"    "$personal/git/allowed-emails"
    check_link "$HOME/.config/git/blocked-domains"   "$personal/git/blocked-domains" ;;
  vanilla) say_ok "프로필 vanilla" ;;
  *) say_warn "프로필이 없다 — install.sh --profile vanilla|personal 실행" ;;
esac

# Linux: <호스트>.local 은 avahi 가 알린다 — 꺼져 있으면 다른 PC 가 이 PC 를 이름으로 못 찾는다
if [ "$(uname -s)" = Linux ] && ! grep -qi microsoft /proc/version 2>/dev/null && systemctl list-unit-files avahi-daemon.service >/dev/null 2>&1; then
  if ! systemctl is-active -q avahi-daemon; then say_bad "avahi-daemon 이 꺼져 있다 — 다른 PC 가 $(hostname -s).local 을 못 찾는다 (sudo systemctl restart avahi-daemon)"
  elif [ ! -f /etc/systemd/system/avahi-daemon.service.d/restart.conf ]; then say_warn "avahi-daemon 재시작 설정이 없다 — sudo bash $dotfiles/setup/avahi-restart.sh"
  else say_ok "avahi-daemon 동작 중, 재시작 설정 있음"; fi
fi
if command -v graphify >/dev/null 2>&1; then say_ok "graphify 설치됨"; else say_warn "graphify 없음 (uv tool install graphifyy && graphify install --platform claude)"; fi
if [ -f "$HOME/.claude/skills/graphify/SKILL.md" ]; then say_ok "graphify 스킬 설치됨"; else say_warn "graphify 스킬 없음 (graphify install --platform claude)"; fi
# 전역 CLAUDE.md 는 dotfiles 를 가리켜야 PC 마다 같은 규칙을 쓴다 — install.sh 의 --claude-md 를 빠뜨려
# 한 PC 만 옛 파일(graphify 규칙 없음)을 쓴 적이 있다
if [ -e "$HOME/.claude" ]; then
  if [ "$(readlink "$HOME/.claude/CLAUDE.md" 2>/dev/null)" = "$dotfiles/claude/CLAUDE.md" ]; then say_ok "전역 CLAUDE.md → dotfiles"; else say_bad "$HOME/.claude/CLAUDE.md 가 dotfiles 를 가리키지 않음 — install.sh --claude-md"; fi
fi
# graphify install 은 CLAUDE.md 의 '# graphify' 섹션을 통째로 다시 쓴다 — 사용 기준은 별도 최상위 섹션이어야 살아남는다.
if grep -q '^# When to use graphify' "$dotfiles/claude/CLAUDE.md"; then say_ok "CLAUDE.md graphify 사용 기준 있음"; else say_bad "CLAUDE.md 에 '# When to use graphify' 섹션이 없음 (graphify install 이 지웠을 수 있다)"; fi

flags=$(git config --get sync.pullFlags 2>/dev/null || true)
if [[ "$flags" == *--ci-gate* ]]; then
  if gh auth status >/dev/null 2>&1; then say_ok "gh 인증됨 (ci-gate)"; else say_bad "sync.pullFlags 가 --ci-gate 인데 gh 미인증 — 전부 hold 된다"; fi
fi

peers=$(git config --get sync.peers 2>/dev/null || true)
for p in $peers; do
  if ssh -o BatchMode=yes -o ConnectTimeout=5 "$p" true 2>/dev/null; then say_ok "ssh $p"; else say_bad "ssh $p 불가 — push 후 상대 PC 동기화가 안 된다"; fi
done

# ── crontab ─────────────────────────────────────────────────────────────────
# 테스트는 REPOS_DOCTOR_CRONTAB=<파일> 로 crontab 대신 파일을 읽힌다
if [ -n "${REPOS_DOCTOR_CRONTAB:-}" ]; then ct=$(cat "$REPOS_DOCTOR_CRONTAB"); else ct=$(crontab -l 2>/dev/null || true); fi
if [ -n "$ct" ] && command -v python3 >/dev/null; then
  while IFS=$'\t' read -r kind msg; do
    [ -n "$kind" ] || continue
    if [ "$kind" = bad ]; then say_bad "$msg"; else say_warn "$msg"; fi
  done < <(python3 -I -c '
import os, re, shlex, sys
block = None
for n, line in enumerate(sys.stdin.read().splitlines(), 1):
    m = re.match(r"# >>> managed: (\S+)", line)
    if m:
        block = m.group(1); continue
    if line.startswith("# <<< managed"):
        block = None; continue
    s = line.strip()
    if not s or s.startswith("#") or re.match(r"^[A-Za-z_]\w*=", s):
        continue
    cmd = s.split(None, 5)[5] if not s.startswith("@") else s.split(None, 1)[-1]
    where = f"crontab {n}번 줄" + (f" [{block}]" if block else "")
    if block is None:
        print(f"warn\t{where}: cron-install 관리 블록 밖의 줄 — 레포 deploy/crontab.<호스트> 로 옮길 것: {cmd[:80]}")
    try:
        toks = shlex.split(cmd, comments=True)
    except ValueError:
        continue
    skip = False
    for i, t in enumerate(toks):
        if skip:
            skip = False; continue
        if t in (">", ">>", "2>", "2>>", "&>", "<"):
            skip = True; continue  # 출력 파일은 실행이 만든다
        if t.startswith(("/", "~/")) and (i == 0 or toks[i - 1] not in ("mkdir", "-p", "touch")):
            p = os.path.expanduser(re.split(r"[;&|\s]", t)[0])  # 따옴표 안의 "경로 옵션" 은 첫 단어만
            if p and not os.path.exists(p):
                print(f"bad\t{where}: 없는 경로 {p} — 이 작업은 돌지 않는다")
' <<<"$ct")
fi

# ── 레포별 ─────────────────────────────────────────────────────────────────
delegated_hooks="pre-push post-commit post-checkout post-merge"

for root in "${roots[@]}"; do
  for d in "$root"/*/; do
    d=${d%/}; [ -e "$d/.git" ] || continue
    n=$(basename "$d")
    before=$problems
    out=()

    # 1. 레포 전용 core.hooksPath
    hp=$(git -C "$d" config --local --get core.hooksPath 2>/dev/null || true)
    if [ -n "$hp" ]; then
      case "$hp" in
        /*|~*) out+=("${RED}✗${R} core.hooksPath 가 절대경로 $hp — 전역 훅(신원 검사·동기화)이 안 돈다"); problems=$((problems + 1)) ;;
        # Husky 가 훅을 관리하는 레포(주로 남의 프로젝트 포크)는 일부러 전역 훅을 잇지 않는다:
        # .husky/_ 는 npm install 때마다 다시 만들어지고, 이으면 push 마다 그 프로젝트의 CI 전체가 로컬에서 돈다.
        .husky/_|.husky) [ $verbose = 1 ] && out+=("${GRN}✓${R} Husky 가 훅을 관리 — 전역 훅 위임은 건너뜀") ;;
        *)
          if [ ! -d "$d/$hp" ]; then
            out+=("${RED}✗${R} core.hooksPath=$hp 폴더가 없음"); problems=$((problems + 1))
          else
            missing=()
            for h in $delegated_hooks; do
              grep -q '.config/git/hooks' "$d/$hp/$h" 2>/dev/null || missing+=("$h")
            done
            [ ${#missing[@]} -gt 0 ] && { out+=("${YLW}●${R} $hp 에 전역 훅 위임 없음: ${missing[*]}"); problems=$((problems + 1)); }
          fi ;;
      esac
    fi

    # 2. .venv 실행 파일 shebang
    if [ -d "$d/.venv/bin" ]; then
      for s in pytest mypy ruff pip; do
        f="$d/.venv/bin/$s"; [ -f "$f" ] || continue
        interp=$(head -1 "$f" | sed -n 's/^#!\([^ ]*\).*/\1/p')
        if [ -n "$interp" ] && [ ! -x "$interp" ]; then
          out+=("${RED}✗${R} .venv/bin/$s shebang 이 없는 경로: $interp — uv sync --reinstall")
          problems=$((problems + 1)); break
        fi
      done
    fi

    # 3. graphify 그래프 — 자동 갱신 훅은 2026-10-19 제거. 그래프가 없어도 문제가 아니고, 있으면 커밋되지 않는지만 본다.
    if [ -d "$d/graphify-out" ] && ! git -C "$d" check-ignore -q graphify-out/graph.json 2>/dev/null; then
      out+=("${RED}✗${R} graphify-out/ 이 무시되지 않음 — 커밋될 수 있다"); problems=$((problems + 1))
    fi
    [ -n "$(git -C "$d" ls-files -- graphify-out 2>/dev/null)" ] && { out+=("${RED}✗${R} graphify-out/ 이 git 에 추적되고 있음"); problems=$((problems + 1)); }

    # 4. 폴더 이름 = origin 레포 이름 — GitHub 에서 이름을 바꾼 뒤 폴더만 옛 이름이면 경로를 쓰는 크론·문서가 헷갈린다
    origin=$(git -C "$d" remote get-url origin 2>/dev/null || true)
    if [ -n "$origin" ]; then
      rn=$(basename "${origin%.git}")
      [ "$rn" = "$n" ] || { out+=("${YLW}●${R} 폴더 이름이 origin 레포($rn)와 다름 — mv 후 크론·Orca 경로도 바꿀 것"); problems=$((problems + 1)); }
    fi

    if [ $problems -gt $before ]; then
      echo "  ${B}$n${R}"
      for line in "${out[@]}"; do echo "    $line"; done
    else
      say_ok "$n"
    fi
  done
done

if [ $problems -eq 0 ]; then echo "  ${D}──${R} ${GRN}문제 없음${R}"
else echo "  ${D}──${R} ${RED}${problems}개 문제${R}"; fi
[ $problems -eq 0 ]
