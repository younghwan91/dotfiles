#!/usr/bin/env bash
# gh-protect — 내 공개 레포(포크·보관 제외)마다 "main via PR" ruleset 을 건다: 기본 브랜치는 PR 로만
# 받고(승인 0개 — 혼자 머지 가능), force push 와 삭제는 막는다. 공개 레포는 무료 플랜에서도 ruleset 이 강제된다.
# 새로 만들거나 공개로 바꾼 레포에 빠뜨린 적이 있어 크론으로 매일 돌린다. 다시 돌려도 안전하다.
#
#   gh-protect           빠진 레포에 건다
#   gh-protect --check   빠진 레포만 보고하고 1 로 끝난다
set -euo pipefail
check=0; [ "${1:-}" = --check ] && check=1
owner=$(gh api user -q .login)
rules='{"name":"main via PR","target":"branch","enforcement":"active",
 "conditions":{"ref_name":{"include":["~DEFAULT_BRANCH"],"exclude":[]}},
 "rules":[{"type":"deletion"},{"type":"non_fast_forward"},
  {"type":"pull_request","parameters":{"required_approving_review_count":0,"dismiss_stale_reviews_on_push":false,
   "require_code_owner_review":false,"require_last_push_approval":false,"required_review_thread_resolution":false}}]}'
missing=0 added=0 total=0
while read -r repo; do
  total=$((total + 1))
  have=$(gh api "repos/$owner/$repo/rulesets" -q '[.[]|select(.name=="main via PR")]|length')
  [ "$have" -gt 0 ] && continue
  missing=$((missing + 1))
  if [ $check = 1 ]; then echo "✗ $owner/$repo: main via PR 없음"
  else gh api -X POST "repos/$owner/$repo/rulesets" --input - <<<"$rules" >/dev/null && added=$((added + 1)) && echo "→ $owner/$repo: main via PR"; fi
done < <(gh repo list "$owner" -L 1000 --visibility public --json name,isFork,isArchived \
           -q '.[]|select((.isFork or .isArchived)|not)|.name')
echo "gh-protect: 공개 레포 ${total}개, 빠진 것 ${missing}개$([ $check = 0 ] && echo ", 건 것 ${added}개")"
[ $check = 1 ] && [ $missing -gt 0 ] && exit 1
exit 0
